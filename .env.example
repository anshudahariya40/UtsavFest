# Copy these settings into .env. Keep API keys out of browser files.
HTTPSMS_API_KEY=your_httpsms_api_key
# Number of the Android phone signed into the httpSMS app, including country code.
HTTPSMS_FROM=+919876543210
# Registered user numbers in this project are stored as 10-digit Indian numbers.
HTTPSMS_COUNTRY_CODE=+91
