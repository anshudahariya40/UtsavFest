<script>
    const participationForm = document.getElementById('student-participation-form-element');
    const successPopup = document.getElementById('event-success-popup');
    const closePopupButton = document.getElementById('close-event-popup');
    const facultyEventFormPanel = document.getElementById('faculty-event-form-panel');
    const customFormBuilder = document.getElementById('custom-form-builder');
    const customFormQuestions = document.getElementById('custom-form-questions');
    const customFormStatus = document.getElementById('custom-form-status');
    const customFormPreview = document.getElementById('custom-form-preview');
    const customFormSuccessPopup = document.getElementById('custom-form-success-popup');
    const studentFormSuccessPopup = document.getElementById('student-form-success-popup');
    const toggleCustomForm = document.getElementById('toggle-custom-form');
    const customFormBuilderContainer = document.getElementById('custom-form-builder-container');
    const teacherEditFormState = { formId: null, isEditMode: false };

    function createQuestionRow(question = {}) {
        const row = document.createElement('div');
        row.className = 'custom-question-row';
        row.innerHTML = `
            <div class="custom-question-topline">
                <span class="custom-question-number"></span>
                <button class="remove-question" type="button" aria-label="Remove question"><i class="fa-solid fa-trash"></i></button>
            </div>
            <input class="custom-question-label" type="text" placeholder="Question" value="${escapeAttribute(question.label || '')}" required>
            <div class="custom-question-options">
                <select class="custom-question-type" aria-label="Question type">
                    <option value="short-answer" ${question.type === 'short-answer' ? 'selected' : ''}>Short answer</option>
                    <option value="paragraph" ${question.type === 'paragraph' ? 'selected' : ''}>Paragraph</option>
                    <option value="multiple-choice" ${question.type === 'multiple-choice' ? 'selected' : ''}>Multiple choice</option>
                    <option value="checkboxes" ${question.type === 'checkboxes' ? 'selected' : ''}>Checkboxes</option>
                </select>
                <label class="custom-required"><input class="custom-question-required" type="checkbox" ${question.required ? 'checked' : ''}> Required</label>
            </div>
            <div class="custom-answer-options ${question.type === 'multiple-choice' || question.type === 'checkboxes' ? '' : 'hidden'}">
                <div class="custom-options-list"></div>
                <button class="add-answer-option" type="button"><i class="fa-solid fa-plus"></i> Add option</button>
            </div>`;
        row.querySelector('.remove-question').addEventListener('click', () => {
            row.remove();
            updateQuestionNumbers();
        });
        row.querySelector('.custom-question-type').addEventListener('change', (event) => {
            const isChoiceQuestion = event.target.value === 'multiple-choice' || event.target.value === 'checkboxes';
            row.querySelector('.custom-answer-options').classList.toggle('hidden', !isChoiceQuestion);
            if (isChoiceQuestion && !row.querySelectorAll('.custom-option-input').length) {
                renderOptionInputs(row, ['Option 1', 'Option 2']);
            }
            updateOptionMarkers(row, event.target.value);
        });
        row.querySelector('.add-answer-option').addEventListener('click', () => addOptionInput(row));
        customFormQuestions.appendChild(row);
        if (question.type === 'multiple-choice' || question.type === 'checkboxes') {
            renderOptionInputs(row, question.options?.length ? question.options : ['Option 1', 'Option 2']);
            updateOptionMarkers(row, question.type);
        }
        updateQuestionNumbers();
    }

    function escapeAttribute(value) {
        return String(value).replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }

    function escapeHtml(value) {
        return escapeAttribute(value).replace(/'/g, '&#039;');
    }

    function addOptionInput(row, value = '') {
        const optionsList = row.querySelector('.custom-options-list');
        const optionRow = document.createElement('div');
        optionRow.className = 'custom-option-row';
        optionRow.innerHTML = `
            <span class="custom-option-marker"><i class="fa-regular fa-circle"></i></span>
            <input class="custom-option-input" type="text" placeholder="Option" value="${escapeAttribute(value)}">
            <button class="remove-option" type="button" aria-label="Remove option"><i class="fa-solid fa-xmark"></i></button>`;
        optionRow.querySelector('.remove-option').addEventListener('click', () => {
            optionRow.remove();
        });
        optionsList.appendChild(optionRow);
    }

    function renderOptionInputs(row, options) {
        const optionsList = row.querySelector('.custom-options-list');
        optionsList.innerHTML = '';
        options.forEach((option) => addOptionInput(row, option));
    }

    function updateOptionMarkers(row, questionType) {
        const iconClass = questionType === 'checkboxes' ? 'fa-square' : 'fa-circle';
        row.querySelectorAll('.custom-option-marker i').forEach((icon) => {
            icon.className = `fa-regular ${iconClass}`;
        });
    }

    function getQuestionOptions(row) {
        return [...row.querySelectorAll('.custom-option-input')]
            .map((input) => input.value.trim())
            .filter(Boolean);
    }

    function updateQuestionNumbers() {
        customFormQuestions?.querySelectorAll('.custom-question-row').forEach((row, index) => {
            row.querySelector('.custom-question-number').textContent = `Question ${index + 1}`;
        });
    }

    function collectCustomForm() {
        return {
            title: document.getElementById('custom-form-title').value.trim(),
            description: document.getElementById('custom-form-description').value.trim(),
            startAt: document.getElementById('custom-form-start-at').value,
            endAt: document.getElementById('custom-form-end-at').value,
            visibleToStudents: document.getElementById('custom-form-student-access').checked,
            questions: [...customFormQuestions.querySelectorAll('.custom-question-row')].map((row) => ({
                label: row.querySelector('.custom-question-label').value.trim(),
                type: row.querySelector('.custom-question-type').value,
                required: row.querySelector('.custom-question-required').checked,
                options: getQuestionOptions(row)
            }))
        };
    }

    function renderCustomForm(form) {
        document.getElementById('custom-form-title').value = form.title || '';
        document.getElementById('custom-form-description').value = form.description || '';
        document.getElementById('custom-form-start-at').value = form.startAt || form.publishAt || '';
        document.getElementById('custom-form-end-at').value = form.endAt || '';
        document.getElementById('custom-form-student-access').checked = Boolean(form.visibleToStudents);
        customFormQuestions.innerHTML = '';
        (form.questions || []).forEach((question) => createQuestionRow(question));
        if (!form.questions?.length) createQuestionRow();
        updateCustomFormCountdown();
    }

    function updateCustomFormCountdown() {
        const countdown = document.getElementById('custom-form-countdown');
        const startInput = document.getElementById('custom-form-start-at');
        const endInput = document.getElementById('custom-form-end-at');
        if (!countdown || !startInput.value || !endInput.value) {
            if (countdown) countdown.textContent = 'Choose a starting and ending time.';
            return;
        }

        const now = Date.now();
        const startTime = new Date(startInput.value).getTime();
        const endTime = new Date(endInput.value).getTime();
        const remaining = startTime - now;
        const formatRemaining = (milliseconds) => {
            const totalMinutes = Math.floor(milliseconds / 60000);
            const days = Math.floor(totalMinutes / 1440);
            const hours = Math.floor((totalMinutes % 1440) / 60);
            const minutes = totalMinutes % 60;
            const parts = [];
            if (days) parts.push(`${days} day${days === 1 ? '' : 's'}`);
            if (hours) parts.push(`${hours} hour${hours === 1 ? '' : 's'}`);
            if (minutes) parts.push(`${minutes} minute${minutes === 1 ? '' : 's'}`);
            return parts.join(' ') || 'less than a minute';
        };

        if (now < startTime) {
            countdown.textContent = `Starts in ${formatRemaining(remaining)}.`;
            countdown.classList.remove('countdown-live', 'countdown-closed');
            return;
        }
        if (now >= endTime) {
            countdown.textContent = 'This form is closed.';
            countdown.classList.add('countdown-closed');
            countdown.classList.remove('countdown-live');
            return;
        }

        countdown.textContent = `Live now. Ends in ${formatRemaining(endTime - now)}.`;
        countdown.classList.add('countdown-live');
        countdown.classList.remove('countdown-closed');
    }

    function showCustomFormPreview() {
        const form = collectCustomForm();
        document.getElementById('preview-form-title').textContent = form.title || 'Untitled form';
        document.getElementById('preview-form-description').textContent = form.description;
        document.getElementById('preview-form-questions').innerHTML = form.questions.map((question, index) => `
            <label class="preview-question"><span>${index + 1}. ${escapeAttribute(question.label || 'Untitled question')}${question.required ? ' *' : ''}</span>
            ${question.type === 'paragraph' ? '<textarea rows="3" disabled></textarea>' : question.type === 'multiple-choice' || question.type === 'checkboxes' ? question.options.map((option) => `<span class="preview-option"><input type="${question.type === 'multiple-choice' ? 'radio' : 'checkbox'}" disabled> ${escapeHtml(option)}</span>`).join('') : '<input type="text" disabled placeholder="Your answer">'}</label>`).join('');
        customFormPreview.classList.remove('hidden');
        customFormPreview.setAttribute('aria-hidden', 'false');
    }

    if (customFormBuilder) {
        const savedDraft = localStorage.getItem('utsavfest_teacher_form_draft');
        renderCustomForm(savedDraft ? JSON.parse(savedDraft) : {});
        toggleCustomForm?.addEventListener('click', () => {
            const isVisible = customFormBuilderContainer.classList.toggle('visible');
            toggleCustomForm.textContent = isVisible ? 'Hide Form Builder' : 'Show Form Builder';
        });
        document.getElementById('add-form-question').addEventListener('click', () => createQuestionRow());
        document.getElementById('preview-custom-form').addEventListener('click', showCustomFormPreview);
        customFormBuilder.addEventListener('input', () => localStorage.setItem('utsavfest_teacher_form_draft', JSON.stringify(collectCustomForm())));
        document.getElementById('custom-form-start-at').addEventListener('input', updateCustomFormCountdown);
        document.getElementById('custom-form-end-at').addEventListener('input', updateCustomFormCountdown);
        setInterval(updateCustomFormCountdown, 60000);
        customFormBuilder.addEventListener('submit', async (event) => {
            event.preventDefault();
            const form = collectCustomForm();
            if (!form.questions.length || form.questions.some((question) => !question.label)) {
                customFormStatus.textContent = 'Add a label to every question before saving.';
                return;
            }
            const choiceQuestionWithoutOptions = form.questions.find((question) => (question.type === 'multiple-choice' || question.type === 'checkboxes') && question.options.length < 2);
            if (choiceQuestionWithoutOptions) {
                customFormStatus.textContent = 'Add at least two answer options to every choice question.';
                return;
            }
            if (!form.startAt || !form.endAt || Number.isNaN(new Date(form.startAt).getTime()) || Number.isNaN(new Date(form.endAt).getTime())) {
                customFormStatus.textContent = 'Choose both a starting time and ending time.';
                return;
            }
            if (new Date(form.endAt).getTime() <= new Date(form.startAt).getTime()) {
                customFormStatus.textContent = 'Ending time must be after starting time.';
                return;
            }

            const endpoint = teacherEditFormState.isEditMode ? '/edit-custom-form' : '/save-custom-form';
            const payload = teacherEditFormState.isEditMode ? { ...form, formId: teacherEditFormState.formId } : form;

            const response = await fetch(endpoint, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const result = await response.json();
            customFormStatus.textContent = result.success ? (teacherEditFormState.isEditMode ? 'Form updated successfully.' : 'Form saved for your class.') : (result.message || 'Unable to save form.');
            if (result.success) {
                localStorage.setItem('utsavfest_teacher_form_draft', JSON.stringify(form));
                customFormBuilderContainer.classList.remove('visible');
                toggleCustomForm.textContent = 'Show Form Builder';
                teacherEditFormState.formId = null;
                teacherEditFormState.isEditMode = false;
                window.location.reload();
            }
        });
    }

    document.getElementById('close-custom-form-preview')?.addEventListener('click', () => {
        customFormPreview.classList.add('hidden');
        customFormPreview.setAttribute('aria-hidden', 'true');
    });

    document.getElementById('close-custom-form-success')?.addEventListener('click', () => {
        customFormSuccessPopup.classList.add('hidden');
    });

    function preloadTeacherFormIntoBuilder(form) {
        if (!form) return;
        teacherEditFormState.formId = form.id;
        teacherEditFormState.isEditMode = true;
        renderCustomForm(form);
        customFormBuilderContainer?.classList.add('visible');
        toggleCustomForm && (toggleCustomForm.textContent = 'Hide Form Builder');
        customFormStatus.textContent = 'Editing existing form';
    }

    document.querySelectorAll('.edit-form-button').forEach((button) => {
        button.addEventListener('click', async () => {
            const formId = button.dataset.formId;
            const form = window.__teacherForms?.find((savedForm) => savedForm.id === formId) || null;
            if (!form) {
                alert('Form data not found.');
                return;
            }
            preloadTeacherFormIntoBuilder(form);
        });
    });

    document.querySelectorAll('.delete-form-button').forEach((button) => {
        button.addEventListener('click', async () => {
            const formId = button.dataset.formId;
            const confirmed = window.confirm('Delete this form? This action cannot be undone.');
            if (!confirmed) return;

            const response = await fetch('/delete-custom-form', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ formId })
            });
            const result = await response.json();
            if (!result.success) {
                alert(result.message || 'Unable to delete form.');
                return;
            }

            button.closest('.created-form-item')?.remove();
            window.location.reload();
        });
    });

    document.querySelectorAll('.student-form-visibility-button').forEach((button) => {
        button.addEventListener('click', async () => {
            const currentlyVisible = button.dataset.visibleToStudents === 'true';
            if (currentlyVisible && !window.confirm('Hide this form from the student dashboard? You can publish it again later.')) return;

            button.disabled = true;
            try {
                const response = await fetch('/set-student-form-visibility', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ formId: button.dataset.formId, visibleToStudents: !currentlyVisible })
                });
                const result = await response.json();
                if (!result.success) {
                    window.alert(result.message || 'Unable to update student dashboard visibility.');
                    button.disabled = false;
                    return;
                }
                window.location.reload();
            } catch (error) {
                window.alert('Unable to update the form. Check your connection and try again.');
                button.disabled = false;
            }
        });
    });

    document.querySelectorAll('.admin-user-delete-button').forEach((button) => {
        button.addEventListener('click', async () => {
            const role = button.dataset.userRole;
            const email = button.dataset.userEmail;
            if (!window.confirm(`Permanently delete this ${role} account${email ? ` (${email})` : ''}? This cannot be undone.`)) return;

            button.disabled = true;
            try {
                const response = await fetch('/delete-managed-user', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ userId: button.dataset.userId, role })
                });
                const result = await response.json();
                if (!result.success) {
                    window.alert(result.message || 'Unable to delete this account.');
                    button.disabled = false;
                    return;
                }
                window.location.reload();
            } catch (error) {
                window.alert('Unable to delete this account. Check your connection and try again.');
                button.disabled = false;
            }
        });
    });

    const festivalEditModal = document.getElementById('festival-edit-modal');
    const festivalEditForm = document.getElementById('festival-edit-form');
    const festivalEditStatus = document.getElementById('festival-edit-status');
    const festivalEditPreviewImage = document.getElementById('edit-festival-preview-image');
    const festivalEditPreviewCover = festivalEditPreviewImage?.closest('.festival-edit-preview-cover');
    const festivalEditNameInput = document.getElementById('edit-festival-name');
    const festivalEditDateInput = document.getElementById('edit-festival-date');
    const festivalEditCurrentDate = document.getElementById('edit-festival-current-date');
    const festivalEditLocationInput = document.getElementById('edit-festival-location');
    const festivalEditImageInput = document.getElementById('edit-festival-image');
    let activeFestivalId = null;

    function updateFestivalEditPreview() {
        const name = festivalEditNameInput?.value.trim() || 'Festival name';
        const dateValue = festivalEditDateInput?.value;
        const locationValue = festivalEditLocationInput?.value.trim() || 'Add a location';

        const previewName = document.getElementById('edit-festival-preview-name');
        const previewDate = document.getElementById('edit-festival-preview-date');
        const previewLocation = document.getElementById('edit-festival-preview-location');

        if (previewName) previewName.textContent = name;
        if (previewDate) {
            previewDate.innerHTML = dateValue
                ? `<i class="fa-regular fa-calendar"></i> ${new Date(`${dateValue}T00:00:00`).toLocaleDateString(undefined, { dateStyle: 'long' })}`
                : '<i class="fa-regular fa-calendar"></i> Select a date';
        }
        if (previewLocation) {
            previewLocation.innerHTML = `<i class="fa-solid fa-location-dot"></i> ${locationValue}`;
        }
    }

    function showFestivalEditModal() {
        if (!festivalEditModal) return;
        festivalEditModal.classList.remove('hidden');
        festivalEditModal.setAttribute('aria-hidden', 'false');
    }

    function hideFestivalEditModal() {
        if (!festivalEditModal) return;
        festivalEditModal.classList.add('hidden');
        festivalEditModal.setAttribute('aria-hidden', 'true');
        if (festivalEditForm) festivalEditForm.reset();
        festivalEditStatus.textContent = '';
        festivalEditStatus.classList.remove('error');
        activeFestivalId = null;
        if (festivalEditPreviewImage) festivalEditPreviewImage.removeAttribute('src');
        festivalEditPreviewCover?.classList.remove('has-image');
    }

    document.getElementById('close-festival-edit-modal')?.addEventListener('click', hideFestivalEditModal);
    document.getElementById('cancel-festival-edit')?.addEventListener('click', hideFestivalEditModal);
    festivalEditNameInput?.addEventListener('input', updateFestivalEditPreview);
    festivalEditDateInput?.addEventListener('input', updateFestivalEditPreview);
    festivalEditLocationInput?.addEventListener('input', updateFestivalEditPreview);
    festivalEditImageInput?.addEventListener('change', () => {
        const file = festivalEditImageInput.files && festivalEditImageInput.files[0];
        if (!file) {
            if (festivalEditPreviewImage) festivalEditPreviewImage.removeAttribute('src');
            festivalEditPreviewCover?.classList.remove('has-image');
            return;
        }
        if (file.size > 5 * 1024 * 1024) {
            festivalEditStatus.textContent = 'Please choose an image smaller than 5 MB.';
            festivalEditStatus.classList.add('error');
            festivalEditImageInput.value = '';
            return;
        }
        const reader = new FileReader();
        reader.onload = () => {
            if (festivalEditPreviewImage) festivalEditPreviewImage.src = reader.result;
            festivalEditPreviewCover?.classList.add('has-image');
            festivalEditStatus.textContent = '';
            festivalEditStatus.classList.remove('error');
        };
        reader.readAsDataURL(file);
    });

    festivalEditForm?.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!activeFestivalId) return;

        festivalEditStatus.textContent = '';
        festivalEditStatus.classList.remove('error');

        const formData = new FormData(festivalEditForm);
        const imageFile = formData.get('imageFile');
        formData.delete('imageFile');

        let nextImage = null;
        if (imageFile instanceof File && imageFile.size > 0) {
            nextImage = await new Promise((resolve, reject) => {
                const reader = new FileReader();
                reader.onload = () => resolve(reader.result);
                reader.onerror = reject;
                reader.readAsDataURL(imageFile);
            });
        }

        const payload = {
            ...Object.fromEntries(['festName', 'time', 'chiefGuest', 'description', 'notification'].map((field) => [field, String(formData.get(field) || '').trim()])),
            festivalId: activeFestivalId,
            eventName: formData.get('eventName')?.toString().trim(),
            eventDate: formData.get('eventDate')?.toString().trim(),
            eventLocation: formData.get('eventLocation')?.toString().trim(),
            ...(nextImage ? { image: nextImage } : {})
        };

        const response = await fetch('/edit-festival', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify(payload)
        });
        const result = await response.json();

        if (!result.success) {
            festivalEditStatus.textContent = result.message || 'Unable to update festival.';
            festivalEditStatus.classList.add('error');
            return;
        }

        hideFestivalEditModal();
        window.location.reload();
    });

    document.querySelectorAll('.festival-edit-button').forEach((button) => {
        button.addEventListener('click', () => {
            const festivalId = button.dataset.festivalId;
            const festivalCard = button.closest('.dashboard-event-card');
            if (!festivalId || !festivalCard) return;

            const currentName = festivalCard.querySelector('h3')?.textContent.trim() || '';
            const currentDate = festivalCard.dataset.eventDate || '';
            const currentDateLabel = festivalCard.dataset.eventDateLabel || 'TBA';
            const currentLocation = festivalCard.querySelector('.dashboard-event-location')?.textContent.replace(/^[^\w]+/, '').trim() || '';
            const currentImage = festivalCard.querySelector('.dashboard-event-image')?.style.backgroundImage || '';
            const currentImageUrl = currentImage.match(/url\((['"]?)(.*?)\1\)/)?.[2] || '';

            const details = JSON.parse(festivalCard.dataset.eventDetails || '{}');
            ['festName', 'time', 'chiefGuest', 'description', 'notification'].forEach((field) => {
                festivalEditForm.elements.namedItem(field).value = details[field] || '';
            });
            activeFestivalId = festivalId;
            festivalEditNameInput.value = currentName;
            festivalEditDateInput.value = currentDate && /^\d{4}-\d{2}-\d{2}$/.test(currentDate) ? currentDate : '';
            festivalEditCurrentDate.textContent = currentDate
                ? ''
                : `Saved date: ${currentDateLabel}. Choose a date only if you want to change it.`;
            festivalEditLocationInput.value = currentLocation.replace(/^Location\s*:/i, '').trim();
            festivalEditImageInput.value = '';
            if (festivalEditPreviewImage) {
                if (currentImageUrl) {
                    festivalEditPreviewImage.src = currentImageUrl;
                    festivalEditPreviewCover?.classList.add('has-image');
                } else {
                    festivalEditPreviewImage.removeAttribute('src');
                    festivalEditPreviewCover?.classList.remove('has-image');
                }
            }

            updateFestivalEditPreview();
            showFestivalEditModal();
        });
    });

    document.querySelectorAll('.festival-delete-button').forEach((button) => {
        button.addEventListener('click', async () => {
            const festivalId = button.dataset.festivalId;
            if (!festivalId || !window.confirm('Delete this festival event?')) return;

            button.disabled = true;
            try {
                const response = await fetch('/delete-festival', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
                    body: JSON.stringify({ festivalId })
                });
                const result = await response.json();
                if (response.ok && result.success) {
                    window.location.reload();
                } else {
                    window.alert(result.message || 'Unable to delete festival.');
                }
            } catch (error) {
                window.alert('Unable to delete the event. Please try again.');
            } finally {
                button.disabled = false;
            }
        });
    });

    const coordinatorEventSearch = document.getElementById('coordinator-event-search');
    const coordinatorEventSearchStatus = document.getElementById('coordinator-event-search-status');
    if (coordinatorEventSearch) {
        const coordinatorEventCards = [...document.querySelectorAll('.dashboard-event-card[data-event-name]')];
        const updateCoordinatorEventSearch = () => {
            const query = coordinatorEventSearch.value.trim().toLowerCase();
            let visibleCount = 0;
            coordinatorEventCards.forEach((card) => {
                const matches = !query || card.dataset.eventName.includes(query);
                card.classList.toggle('hidden', !matches);
                if (matches) visibleCount += 1;
            });
            if (coordinatorEventSearchStatus) {
                coordinatorEventSearchStatus.textContent = query
                    ? `${visibleCount} event${visibleCount === 1 ? '' : 's'} found`
                    : `${visibleCount} event${visibleCount === 1 ? '' : 's'} created by you`;
            }
        };
        coordinatorEventSearch.addEventListener('input', updateCoordinatorEventSearch);
        document.querySelectorAll('[data-event-search-example]').forEach((exampleButton) => {
            exampleButton.addEventListener('click', () => {
                coordinatorEventSearch.value = exampleButton.dataset.eventSearchExample || '';
                coordinatorEventSearch.dispatchEvent(new Event('input'));
                coordinatorEventSearch.focus();
            });
        });
        updateCoordinatorEventSearch();
    }

    window.__teacherForms = <%- JSON.stringify(facultyForms || []) %>;

    document.querySelectorAll('.student-shared-form').forEach((studentForm) => {
        studentForm.addEventListener('submit', async (event) => {
            event.preventDefault();
            const formCard = studentForm.closest('.dashboard-shared-form-card');
            const studentName = studentForm.querySelector('[name="studentName"]')?.value.trim();
            const semester = studentForm.querySelector('[name="semester"]')?.value;
            const answers = [...studentForm.querySelectorAll('.student-form-question')].map((question) => {
                const questionType = question.dataset.questionType;
                if (questionType === 'checkboxes') {
                    return [...question.querySelectorAll('input[type="checkbox"]:checked')].map((input) => input.value);
                }
                if (questionType === 'multiple-choice') {
                    return question.querySelector('input[type="radio"]:checked')?.value || '';
                }
                return question.querySelector('textarea, input[type="text"]')?.value.trim() || '';
            });
            const response = await fetch('/submit-custom-form', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ formId: formCard?.dataset.formId, studentName, semester, answers })
            });
            const result = await response.json();
            if (!result.success) {
                alert(result.message || 'Unable to submit form.');
                return;
            }
            if (result.score !== null && result.score !== undefined) {
                window.location.reload();
                return;
            }
            studentFormSuccessPopup.classList.remove('hidden');
            formCard?.remove();
        });
    });

    document.getElementById('close-student-form-success')?.addEventListener('click', () => {
        studentFormSuccessPopup.classList.add('hidden');
    });

    function formatStudentFormTime(milliseconds) {
        const totalMinutes = Math.max(0, Math.floor(milliseconds / 60000));
        const days = Math.floor(totalMinutes / 1440);
        const hours = Math.floor((totalMinutes % 1440) / 60);
        const minutes = totalMinutes % 60;
        const parts = [];
        if (days) parts.push(`${days} day${days === 1 ? '' : 's'}`);
        if (hours) parts.push(`${hours} hour${hours === 1 ? '' : 's'}`);
        if (!days && minutes) parts.push(`${minutes} minute${minutes === 1 ? '' : 's'}`);
        return parts.join(' ') || 'less than a minute';
    }

    function updateStudentFormTimers() {
        document.querySelectorAll('.dashboard-shared-form-card').forEach((formCard) => {
            const timer = formCard.querySelector('[data-student-form-timer]');
            const startTime = new Date(formCard.dataset.formStart).getTime();
            const endTime = new Date(formCard.dataset.formEnd).getTime();
            if (!timer || Number.isNaN(startTime) || Number.isNaN(endTime)) return;
            const now = Date.now();
            const form = formCard.querySelector('.student-shared-form');
            if (now >= endTime) {
                formCard.remove();
                return;
            }
            if (now < startTime) {
                form?.querySelectorAll('input, select, textarea, button').forEach((control) => {
                    control.disabled = true;
                });
                timer.textContent = `Available from ${new Date(startTime).toLocaleString()}.`;
                return;
            }
            form?.querySelectorAll('input, select, textarea, button').forEach((control) => {
                control.disabled = false;
            });
            timer.textContent = `Available now. Closes in ${formatStudentFormTime(endTime - now)}.`;
        });
    }

    updateStudentFormTimers();
    setInterval(updateStudentFormTimers, 60000);

    function showEventSuccessPopup() {
        if (successPopup) {
            successPopup.classList.remove('hidden');
        }
    }

    function hideEventSuccessPopup() {
        if (successPopup) {
            successPopup.classList.add('hidden');
        }
    }

    if (closePopupButton) {
        closePopupButton.addEventListener('click', hideEventSuccessPopup);
    }

    if (participationForm) {
        participationForm.addEventListener('submit', async (event) => {
            event.preventDefault();
            const formData = new FormData(participationForm);
            const payload = new URLSearchParams();

            for (const [key, value] of formData.entries()) {
                payload.append(key, value);
            }

            const response = await fetch('/add-participation', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: payload.toString()
            });

            const result = await response.json();
            if (result.success) {
                participationForm.reset();
                const popupTitle = document.querySelector('#event-success-popup h3');
                const popupText = document.querySelector('#event-success-popup p');
                if (popupTitle) popupTitle.textContent = 'Participation Registered Successfully';
                if (popupText) popupText.textContent = 'Your event participation details have been saved to MongoDB.';
                showEventSuccessPopup();
                return;
            }

            alert(result.message || 'Unable to register for event.');
        });
    }
</script>
</html>
