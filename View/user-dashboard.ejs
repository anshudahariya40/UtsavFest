<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard | UtsavFest</title>
    <link href="/fest.css" rel="stylesheet">
    <link href="/responsive-images.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Poppins:wght@600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="dashboard-page<%= isEventCoordinator ? ' coordinator-dashboard-page' : '' %>">
    <nav>
        <a class="logo" href="/fest.html">
            <img src="/image.png" alt="UtsavFest logo">
            <span>UtsavFest</span>
        </a>
        <button class="mobile-nav-toggle" type="button" aria-label="Open navigation" aria-expanded="false"><i class="fa-solid fa-bars"></i></button>
        <div class="nav-links">
            <a href="/calendar">Calendar</a>
            <a href="/explore">Explore</a>
            <a href="/destinations">Destinations</a>
            <a href="/about">About Us</a>
        </div>
        <div class="nav-actions">
            <a href="/logout">Log out</a>
        </div>
    </nav>

    <main class="dashboard-layout">
        <section class="dashboard-hero">
            <div class="dashboard-heading">
                <p class="dashboard-kicker"><i class="fa-solid fa-sparkles"></i> <%= isEventCoordinator ? 'Event coordinator' : user.role %> account</p>
                <h1>Welcome, <%= user.name || user.studentName || user.teacherName %>.</h1>
                <p>Keep your celebrations organized and discover your next unforgettable event.</p>
            </div>
            <div class="dashboard-hero-mark"><i class="fa-solid fa-fire-flame-curved"></i></div>
        </section>

        <section class="dashboard-stats" aria-label="Account summary">
            <div class="dashboard-stat">
                <span class="dashboard-stat-icon"><i class="fa-solid fa-id-card"></i></span>
                <span><strong>Active</strong><small>Account status</small></span>
            </div>
            <div class="dashboard-stat">
                <span class="dashboard-stat-icon stat-coral"><i class="fa-solid fa-earth-americas"></i></span>
                <span><strong>Global</strong><small>Festival access</small></span>
            </div>
            <div class="dashboard-stat">
                <span class="dashboard-stat-icon stat-green"><i class="fa-solid fa-calendar-check"></i></span>
                <span><strong>4 events</strong><small>Coming soon</small></span>
            </div>
        </section>

        <section class="dashboard-grid">
            <% if (isEventCoordinator) { %><div class="coordinator-overview-column"><% } %>
            <article class="dashboard-card dashboard-profile-card">
                <div class="dashboard-card-heading">
                    <div class="dashboard-icon"><i class="fa-solid fa-user"></i></div>
                    <div>
                        <p class="dashboard-label">Account overview</p>
                        <h2>Profile details</h2>
                    </div>
                </div>
                <div class="dashboard-details">
                    <% if (isEventCoordinator) { %>
                        <% const coordinatorProfile = [
                            ['Name', user.name],
                            ['College', user.collegeName || user.instituteName || user.adminCollege || 'Not provided'],
                            ['Account', 'Event coordinator']
                        ]; %>
                        <% coordinatorProfile.forEach(([label, value]) => { %>
                            <% if (value != null && String(value).trim()) { %>
                                <p><strong><%= label %></strong><span><%= value %></span></p>
                            <% } %>
                        <% }); %>
                    <% } else { %>
                    <p><strong>Email</strong><span><%= user.email %></span></p>
                    <p><strong>Account</strong><span><%= isEventCoordinator ? 'Event coordinator' : user.role %></span></p>
                    <% if (user.role === 'student') { %>
                        <p><strong>College</strong><span><%= user.collegeName %></span></p>
                        <p><strong>Department</strong><span><%= user.department %></span></p>
                        <p><strong>Semester</strong><span><%= user.semester %></span></p>
                        <p><strong>Enrollment</strong><span><%= user.enrollmentNumber %></span></p>
                    <% } else { %>
                        <p><strong>College</strong><span><%= user.adminCollege %></span></p>
                        <p><strong>Department</strong><span><%= user.adminDepartment %></span></p>
                    <% } %>
                    <% } %>
                </div>
            </article>

            <% if (isEventCoordinator) { %>
                <article class="dashboard-card dashboard-participants-card">
                    <div class="dashboard-card-heading">
                        <div class="dashboard-icon dashboard-icon-coral"><i class="fa-solid fa-user-plus" aria-hidden="true"></i></div>
                        <div><p class="dashboard-label">Event registration</p><h2>Add Participants</h2></div>
                    </div>
                    <p class="dashboard-action-copy">Register a student for one of your events.</p>
                    <div class="participant-card-actions">
                        <button class="dashboard-button participant-add-button" id="open-add-participant" type="button"><i class="fa-solid fa-user-plus" aria-hidden="true"></i><span>Add Participant</span></button>
                        <button class="dashboard-button participant-view-button" id="open-view-participants" type="button"><i class="fa-solid fa-list" aria-hidden="true"></i><span>Participants &amp; Winners</span></button>
                    </div>
                </article>
                </div>
                <div class="coordinator-actions-column">
            <% } %>

            <% if (isEventCoordinator) { %>
                <article class="dashboard-card dashboard-form-card" id="event-coordinator-event-form">
                    <div class="dashboard-card-heading">
                        <div class="dashboard-icon dashboard-icon-green"><i class="fa-solid fa-calendar-plus"></i></div>
                        <div>
                            <p class="dashboard-label">Event coordinator</p>
                            <h2>Add New Event</h2>
                        </div>
                    </div>
                    <p class="dashboard-action-copy">Share a campus celebration with the community by adding its details and a cover image.</p>

                    <div class="faculty-event-panel">
                        <div class="faculty-event-actions-row">
                            <a class="dashboard-button dashboard-button-outline" href="/event-coordinator/add-event"><i class="fa-solid fa-arrow-up-right-from-square"></i> Full form</a>
                        </div>

                        <!-- <div id="faculty-event-form-panel" class="faculty-event-form-panel faculty-event-form-panel-empty">
                            <p class="faculty-empty-panel-copy">Use the full event form to add a new festival and publish it to the site.</p>
                        </div> -->
                    </div>
                </article>
            <% } %>

            <article class="dashboard-card dashboard-action-card">
                <div class="dashboard-card-heading">
                    <div class="dashboard-icon dashboard-icon-coral"><i class="fa-solid fa-calendar-days"></i></div>
                    <div>
                        <p class="dashboard-label">Your next experience</p>
                        <h2>Explore celebrations</h2>
                    </div>
                </div>
                <p class="dashboard-action-copy">Find festivals, browse destinations, and plan your next cultural experience.</p>
                <a class="dashboard-button" href="/#upcoming-events">View upcoming events</a>
            </article>

            <% if (isEventCoordinator) { %></div><% } %>

            <% if (user.role === 'student') { %>
                <article class="dashboard-card dashboard-form-card" id="student-participation-form">
                    <div class="dashboard-card-heading">
                        <div class="dashboard-icon dashboard-icon-coral"><i class="fa-solid fa-user-check"></i></div>
                        <div>
                            <p class="dashboard-label">Student participation</p>
                            <h2>Participate in Event</h2>
                        </div>
                    </div>

                    <form id="student-participation-form-element" class="festival-registration-form">
                        <label class="auth-field">
                            Student name
                            <input name="studentName" type="text" placeholder="Enter full name" required>
                        </label>

                        <label class="auth-field">
                            Department
                            <input name="department" type="text" placeholder="Enter department" required>
                        </label>

                        <label class="auth-field">
                            Field of interest
                            <input name="fieldOfInterest" type="text" placeholder="Enter field of interest" required>
                        </label>

                        <label class="auth-field">
                            Semester
                            <select name="semester" required>
                                <option value="" selected disabled>Select semester</option>
                                <option value="1">Semester 1</option>
                                <option value="2">Semester 2</option>
                                <option value="3">Semester 3</option>
                                <option value="4">Semester 4</option>
                                <option value="5">Semester 5</option>
                                <option value="6">Semester 6</option>
                                <option value="7">Semester 7</option>
                                <option value="8">Semester 8</option>
                            </select>
                        </label>

                        <label class="auth-field">
                            College name
                            <input name="collegeName" type="text" placeholder="Enter college name" required>
                        </label>

                        <label class="auth-field">
                            Event name
                            <select name="eventId" required>
                                <option value="" selected disabled>Select event</option>
                                <% festivals.forEach((event) => { %>
                                <option value="<%= event.id %>"><%= event.name %> — <%= event.dateISO || event.date %> — <%= event.location %></option>
                                <% }); %>
                            </select>
                        </label>

                        <button class="dashboard-button" type="submit">Register for event</button>
                    </form>
                </article>
                <% (studentForms || []).forEach((studentForm) => { %>
                    <article class="dashboard-card dashboard-shared-form-card" id="student-form-<%= studentForm.id %>" data-form-id="<%= studentForm.id %>" data-form-start="<%= studentForm.startAt %>" data-form-end="<%= studentForm.endAt %>">
                        <div class="dashboard-card-heading">
                            <div class="dashboard-icon dashboard-icon-green"><i class="fa-solid fa-file-lines"></i></div>
                            <div>
                                <p class="dashboard-label"><%= studentForm.autoGrade ? 'Teacher exam' : 'Teacher form' %></p>
                                <h2><%= studentForm.title %></h2>
                            </div>
                        </div>
                        <% if (studentForm.description) { %>
                            <p class="dashboard-form-intro"><%= studentForm.description %></p>
                        <% } %>
                        <p class="student-form-timer" data-student-form-timer>Checking form availability...</p>
                        <form class="student-shared-form">
                            <label class="auth-field student-form-name-field">
                                Student name
                                <input name="studentName" type="text" placeholder="Enter your full name" required>
                            </label>
                            <label class="auth-field">
                                Semester
                                <select name="semester" required>
                                    <option value="" selected disabled>Select semester</option>
                                    <option value="1">Semester 1</option>
                                    <option value="2">Semester 2</option>
                                    <option value="3">Semester 3</option>
                                    <option value="4">Semester 4</option>
                                    <option value="5">Semester 5</option>
                                    <option value="6">Semester 6</option>
                                    <option value="7">Semester 7</option>
                                    <option value="8">Semester 8</option>
                                </select>
                            </label>
                            <% studentForm.questions.forEach((question, questionIndex) => { %>
                                <fieldset class="student-form-question" data-question-type="<%= question.type %>">
                                    <legend><%= questionIndex + 1 %>. <%= question.label %><%= question.required ? ' *' : '' %></legend>
                                    <% if (question.type === 'paragraph') { %>
                                        <textarea rows="3" <%= question.required ? 'required' : '' %>></textarea>
                                    <% } else if (question.type === 'multiple-choice' || question.type === 'checkboxes') { %>
                                        <div class="student-choice-list">
                                        <% (question.options || []).forEach((option, optionIndex) => { %>
                                            <label><input type="<%= question.type === 'multiple-choice' ? 'radio' : 'checkbox' %>" name="question-<%= questionIndex %>" value="<%= option %>" <%= question.required && (question.type === 'multiple-choice' || optionIndex === 0) ? 'required' : '' %>> <%= option %></label>
                                            <% }); %>
                                        </div>
                                    <% } else { %>
                                        <input type="text" <%= question.required ? 'required' : '' %>>
                                    <% } %>
                                </fieldset>
                            <% }); %>
                            <button class="dashboard-button" type="submit">Submit response</button>
                        </form>
                    </article>
                <% }); %>
            <% } %>

            <% if (user.role === 'student' && (studentFormResults || []).length) { %>
                <article class="dashboard-card dashboard-created-forms-card">
                    <div class="dashboard-card-heading">
                        <div class="dashboard-icon dashboard-icon-green"><i class="fa-solid fa-square-poll-vertical"></i></div>
                        <div>
                            <p class="dashboard-label">Completed quizzes</p>
                            <h2>Your exam results</h2>
                        </div>
                    </div>
                    <div class="created-forms-list">
                        <% studentFormResults.forEach((result) => { %>
                            <section class="created-form-item">
                                <div class="created-form-heading">
                                    <div>
                                        <h3><%= result.formTitle %></h3>
                                        <p>Submitted <%= new Date(result.submittedAt).toLocaleString() %></p>
                                    </div>
                                    <span class="created-form-access">Score: <%= result.score %> / <%= result.total %></span>
                                </div>
                                <div class="created-form-question-list">
                                    <% result.review.forEach((answer, answerIndex) => { %>
                                        <p>
                                            <strong><%= answerIndex + 1 %>. <%= answer.question %></strong>
                                            <span>Your answer: <%= Array.isArray(answer.answer) ? (answer.answer.join(', ') || 'Not answered') : (answer.answer || 'Not answered') %></span>
                                            <span>Correct answer: <%= Array.isArray(answer.correctAnswer) ? answer.correctAnswer.join(', ') : answer.correctAnswer %></span>
                                            <span><%= answer.isCorrect ? 'Correct' : 'Incorrect' %></span>
                                        </p>
                                    <% }); %>
                                </div>
                            </section>
                        <% }); %>
                    </div>
                </article>
            <% } %>

            <% if (user.role === 'faculty') { %>
                <article class="dashboard-card dashboard-form-builder-card" id="faculty-custom-form">
                    <div class="dashboard-card-heading">
                        <div class="dashboard-icon dashboard-icon-gold"><i class="fa-solid fa-list-check"></i></div>
                        <div>
                            <p class="dashboard-label">Teacher workspace</p>
                            <h2>Build a student form</h2>
                        </div>
                    </div>
                    <p class="dashboard-form-intro">Create or edit a registration, feedback, or quiz form for your students.</p>
                    <a class="dashboard-button" href="/faculty/form-builder" target="_blank" rel="noopener"><i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i> Open form builder</a>
                </article>

                <article class="dashboard-card dashboard-created-forms-card">
                    <div class="dashboard-card-heading">
                        <div class="dashboard-icon dashboard-icon-coral"><i class="fa-solid fa-folder-open"></i></div>
                        <div>
                            <p class="dashboard-label">Private workspace</p>
                            <h2>My created forms</h2>
                        </div>
                    </div>
                    <% if (!(facultyForms || []).length) { %>
                        <p class="dashboard-form-intro">Your saved forms will appear here.</p>
                    <% } else { %>
                        <div class="created-forms-list">
                            <% facultyForms.forEach((facultyForm) => { %>
                                <div class="created-form-item" data-form-id="<%= facultyForm.id %>">
                                    <div class="created-form-heading">
                                        <div>
                                            <h3><%= facultyForm.title %></h3>
                                            <p><%= facultyForm.description || 'No description added.' %></p>
                                        </div>
                                        <span class="created-form-access"><%= facultyForm.visibleToStudents ? 'Student access on' : 'Private' %></span>
                                    </div>
                                    <div class="created-form-meta">
                                        <span><i class="fa-solid fa-clock"></i> Starts: <%= new Date(facultyForm.startAt).toLocaleString() %></span>
                                        <span><i class="fa-solid fa-hourglass-end"></i> Ends: <%= new Date(facultyForm.endAt).toLocaleString() %></span>
                                        <span><i class="fa-solid fa-list-check"></i> <%= facultyForm.questions.length %> questions</span>
                                    </div>
                                    <div class="created-form-question-list">
                                        <% facultyForm.questions.forEach((question, questionIndex) => { %>
                                            <p><strong><%= questionIndex + 1 %>. <%= question.label %></strong> <span><%= question.type %><%= question.required ? ' | Required' : '' %><%= question.options && question.options.length ? ` | ${question.options.join(', ')}` : '' %></span></p>
                                        <% }); %>
                                    </div>
                                    <% if (facultyForm.autoGrade || facultyForm.questions.some((question) => question.type === 'teacher-answer')) { %>
                                        <div class="created-form-question-list">
                                            <p><strong>Student results (<%= facultyForm.submissions.length %>)</strong></p>
                                            <% if (!facultyForm.submissions.length) { %>
                                                <p>No students have submitted this quiz yet.</p>
                                            <% } else { %>
                                                <% facultyForm.submissions.forEach((submission) => { %>
                                                    <p>
                                                        <strong><%= submission.studentName %></strong>
                                                        <span>Semester <%= submission.semester %> | Score: <%= submission.score %> / <%= submission.total %></span>
                                                        <span>Submitted <%= new Date(submission.submittedAt).toLocaleString() %></span>
                                                    </p>
                                                <% }); %>
                                            <% } %>
                                        </div>
                                    <% } %>
                                    <div class="created-form-actions">
                                        <a class="dashboard-button dashboard-button-outline" href="/faculty/form-builder?formId=<%= encodeURIComponent(facultyForm.id) %>" target="_blank" rel="noopener">Edit</a>
                                        <button type="button" class="dashboard-button dashboard-button-muted student-form-visibility-button" data-form-id="<%= facultyForm.id %>" data-visible-to-students="<%= facultyForm.visibleToStudents %>">
                                            <i class="fa-solid <%= facultyForm.visibleToStudents ? 'fa-eye-slash' : 'fa-eye' %>" aria-hidden="true"></i>
                                            <%= facultyForm.visibleToStudents ? 'Hide from student dashboard' : 'Publish to student dashboard' %>
                                        </button>
                                    </div>
                                </div>
                            <% }); %>
                        </div>
                    <% } %>
                </article>
            <% } %>
        </section>

        <section class="dashboard-events" id="upcoming-events">
            <div class="dashboard-section-heading">
                <div>
                    <p class="dashboard-kicker">Festival spotlight</p>
                    <h2><%= isEventCoordinator ? 'Manage your events' : 'What is happening soon?' %></h2>
                </div>
                <a href="/fest.html">See all events <i class="fa-solid fa-arrow-right"></i></a>
            </div>
            <% if (isEventCoordinator) { %>
                <label class="coordinator-event-search" for="coordinator-event-search">
                    <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                    <input id="coordinator-event-search" type="search" placeholder="e.g. Campus Cultural Night" autocomplete="off">
                </label>
                <div class="coordinator-event-search-examples" aria-label="Event search examples">
                    <span>Try searching:</span>
                    <button type="button" data-event-search-example="Campus Cultural Night">Campus Cultural Night</button>
                    <button type="button" data-event-search-example="Utsav">Utsav 2026</button>
                    <button type="button" data-event-search-example="Festival">Festival</button>
                </div>
                <p id="coordinator-event-search-status" class="coordinator-event-search-status" aria-live="polite"></p>
            <% } %>
            <div class="dashboard-event-list">
                <% const dashboardEvents = isEventCoordinator ? coordinatorEvents : festivals; %>
                <% if (!dashboardEvents.length) { %>
                    <p class="dashboard-empty-events">No events are available yet.</p>
                <% } %>
                <% dashboardEvents.slice(0, isEventCoordinator ? undefined : 3).forEach((festival) => { %>
                    <article class="dashboard-event-card" data-event-name="<%= String(festival.name || '').toLowerCase() %>" data-festival-id="<%= festival.id || festival._id %>" data-event-date="<%= festival.dateISO || (/^\d{4}-\d{2}-\d{2}$/.test(String(festival.date || '')) ? festival.date : '') %>" data-event-date-label="<%= festival.date || 'TBA' %>" data-event-details="<%= JSON.stringify({ festName: festival.festName, time: festival.time, chiefGuest: festival.chiefGuest, description: festival.description, notification: festival.notification }) %>">
                        <div class="dashboard-event-visual">
                            <div class="dashboard-event-image" style="background-image: url('<%= festival.image %>');"></div>
                            <span class="dashboard-event-date-badge"><%= festival.date %></span>
                        </div>

                        <div class="dashboard-event-content">
                            <div class="dashboard-event-topline">
                                <span class="dashboard-event-chip">Featured</span>
                            </div>
                            <% if (festival.festName) { %><p class="dashboard-label"><%= festival.festName %></p><% } %>
                            <h3><%= festival.name %></h3>
                            <p class="dashboard-event-location"><i class="fa-solid fa-location-dot"></i> <%= festival.location %></p>

                            <% if (festival.time) { %><p>Time: <%= festival.time %></p><% } %>
                            <% if (festival.chiefGuest) { %><p>Chief guest: <%= festival.chiefGuest %></p><% } %>
                            <% if (festival.description) { %><p><%= festival.description %></p><% } %>
                            <% if (festival.notification) { %><p>Notification: <%= festival.notification %></p><% } %>
                            <div class="dashboard-event-footer">
                                <a href="/festival/<%= encodeURIComponent(festival.id || festival._id) %>" class="dashboard-event-link">View details</a>
                                <% if (user && (isEventCoordinator || user.role === 'admin')) { %>
                                    <div class="dashboard-event-actions">
                                        <% if (isEventCoordinator) { %>
                                            <button type="button" class="dashboard-button dashboard-button-outline festival-edit-button" data-festival-id="<%= festival.id || festival._id %>" style="padding: 0.7rem 1rem;">Edit</button>
                                        <% } %>
                                        <% if (isEventCoordinator || user.role === 'admin') { %>
                                            <button type="button" class="dashboard-button dashboard-button-danger festival-delete-button" data-festival-id="<%= festival.id || festival._id %>" style="padding: 0.7rem 1rem;">Delete</button>
                                        <% } %>
                                    </div>
                                <% } %>
                            </div>
                        </div>
                    </article>
                <% }); %>
            </div>
        </section>
    </main>

    <style>
        .dashboard-events {
            display: grid;
            gap: 1.25rem;
            margin-top: 2rem;
        }

        .dashboard-section-heading {
            display: flex;
            align-items: end;
            justify-content: space-between;
            gap: 1rem;
            margin-bottom: 0.5rem;
        }

        .dashboard-section-heading h2 {
            margin: 0.2rem 0 0;
            color: #f4f7ff;
            font-size: clamp(1.7rem, 2vw, 2.25rem);
        }

        .dashboard-section-heading a {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.75rem 1rem;
            border-radius: 999px;
            background: rgba(255, 255, 255, 0.06);
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: #e8eefc;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.2s ease;
        }

        .dashboard-section-heading a:hover {
            transform: translateY(-1px);
            background: rgba(255, 255, 255, 0.09);
        }

        .coordinator-event-search {
            align-items: center;
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.14);
            border-radius: 14px;
            color: #f4b942;
            display: flex;
            gap: 10px;
            max-width: 560px;
            padding: 10px 14px;
            width: 100%;
        }

        .coordinator-event-search:focus-within {
            border-color: rgba(244, 185, 66, 0.72);
            box-shadow: 0 0 0 3px rgba(244, 185, 66, 0.14);
        }

        .coordinator-event-search input {
            background: transparent;
            border: 0;
            color: #f8fbff;
            font: inherit;
            min-height: 30px;
            outline: 0;
            width: 100%;
        }

        .coordinator-event-search input::placeholder {
            color: #bfcae2;
        }

        .coordinator-event-search-status {
            color: #bfcae2;
            font-size: 0.86rem;
            margin: -0.45rem 0 0;
        }

        .coordinator-event-search-examples {
            align-items: center;
            color: #bfcae2;
            display: flex;
            flex-wrap: wrap;
            font-size: 0.78rem;
            gap: 7px;
            margin: -0.45rem 0 0;
        }

        .coordinator-event-search-examples button {
            background: rgba(244, 185, 66, 0.12);
            border: 1px solid rgba(244, 185, 66, 0.35);
            border-radius: 999px;
            color: #f9d57a;
            cursor: pointer;
            font: inherit;
            padding: 4px 10px;
        }

        .coordinator-event-search-examples button:hover,
        .coordinator-event-search-examples button:focus-visible {
            background: rgba(244, 185, 66, 0.22);
            outline: none;
        }

        .dashboard-event-list {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
