                { role: 'faculty', title: 'Faculty', columns: [['name', 'Name'], ['email', 'Email'], ['mobileNumber', 'Mobile number'], ['gender', 'Gender'], ['collegeName', 'College'], ['department', 'Department']] },
                { role: 'event-coordinator', title: 'Event Coordinators', columns: [['instituteName', 'Institute'], ['name', 'Name'], ['gender', 'Gender'], ['email', 'Email'], ['mobileNumber', 'Mobile number'], ['loginId', 'Login ID']] }
