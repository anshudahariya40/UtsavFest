                    <button type="button" id="student-excel-clear" class="admin-user-cancel">Clear preview</button>
                </div>
                <div class="admin-user-table-wrap" tabindex="0" role="region" aria-label="Excel participation results">
                    <table class="admin-user-table" id="student-excel-table"><caption class="participation-caption">Excel participation results</caption><thead><tr><th>Excel row</th><th>Status</th><th>Student name</th><th>Enrollment number</th><th>Mobile number</th><th>Department</th><th>Semester</th><th>College</th><th>Details</th></tr></thead><tbody></tbody></table>
                </div>
                <div class="excel-preview-toolbar">
                    <button type="button" id="student-excel-previous" class="admin-user-cancel">Previous</button>
                    <span id="student-excel-page"></span>
                    <button type="button" id="student-excel-next" class="admin-user-cancel">Next</button>
                </div>
