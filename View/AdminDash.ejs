        <script src="/exceljs.min.js" defer></script>
        <script src="/participation-excel.js" defer></script>
        <section class="dashboard-card admin-account-table-card participation-results" aria-label="Event participant details">
            <% if (dashboardData.selectedEvent) { %>
            <header class="admin-table-heading"><h2><%= dashboardData.selectedEvent.name %></h2><span><%= dashboardData.participants.length %> participation records</span></header>
            <p><%= dashboardData.selectedEvent.dateISO || dashboardData.selectedEvent.date %> · <%= dashboardData.selectedEvent.location %></p>
            <div class="admin-user-table-wrap">
                <table class="admin-user-table">
                    <caption class="participation-caption">Student details and event registrations</caption>
                    <thead><tr><th>Student name</th><th>Enrollment number</th><th>Email</th><th>Mobile number</th><th>Gender</th><th>Department</th><th>Semester</th><th>College name</th><th>Field of interest</th><th>Event name</th><th>Registered on</th></tr></thead>
                    <tbody>
                        <% dashboardData.participants.forEach(participant => { %>
                        <tr>
                            <% ['studentName', 'enrollmentNumber', 'email', 'mobileNumber', 'gender', 'department', 'semester', 'collegeName', 'fieldOfInterest', 'eventName'].forEach(key => { %>
                            <td><%= participant[key] || 'Not recorded' %></td>
                            <% }); %>
                            <td><%= participant.createdAt ? new Date(participant.createdAt).toLocaleString('en-IN', { timeZone: 'Asia/Kolkata' }) : 'Not recorded' %></td>
                        </tr>
                        <% }); %>
                        <% if (!dashboardData.participants.length) { %><tr><td colspan="11">No students have registered for this event yet.</td></tr><% } %>
                    </tbody>
                </table>
            </div>
            <% } else { %>
            <p role="status"><%= dashboardData.participationEvents.length ? 'Select an event above to view its participants.' : 'No events have been scheduled by event coordinators yet.' %></p>
            <% } %>
        </section>
        <% } %>
    </main>
    <script>
        (() => {
            const navToggle = document.querySelector('.mobile-nav-toggle');
            const nav = document.querySelector('nav');
            navToggle?.addEventListener('click', () => {
                const expanded = nav.classList.toggle('mobile-nav-open');
                navToggle.setAttribute('aria-expanded', String(expanded));
                navToggle.setAttribute('aria-label', expanded ? 'Close navigation' : 'Open navigation');
            });
            nav.addEventListener('keydown', (event) => {
                if (event.key === 'Escape' && nav.classList.contains('mobile-nav-open')) {
                    nav.classList.remove('mobile-nav-open');
                    navToggle.setAttribute('aria-expanded', 'false');
                    navToggle.setAttribute('aria-label', 'Open navigation');
                    navToggle.focus();
                }
            });

            document.querySelectorAll('.role-pie-chart').forEach((chart) => {
                const slices = chart.querySelector('.role-pie-slices');
                const unit = chart.dataset.unit;
                const entries = JSON.parse(chart.dataset.chartEntries).map((entry) => ({
                    label: entry.label,
                    count: Math.max(0, Number(entry.count) || 0),
                    color: entry.color
                }));
                const total = entries.reduce((sum, entry) => sum + entry.count, 0);
                const center = 120;
                const radius = 110;
                let angle = -Math.PI / 2;

                chart.parentElement.querySelector('.role-chart-total-count').textContent = total.toLocaleString();


                if (total === 0) {
                    const emptySlice = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
                    emptySlice.setAttribute('cx', center);
                    emptySlice.setAttribute('cy', center);
                    emptySlice.setAttribute('r', radius);
                    emptySlice.setAttribute('class', 'role-pie-empty');
                    slices.append(emptySlice);
                }

                entries.filter((entry) => entry.count > 0).forEach((entry) => {
                    const nextAngle = angle + (entry.count / total) * Math.PI * 2;
                    const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
                    const startX = center + radius * Math.cos(angle);
                    const startY = center + radius * Math.sin(angle);
                    const endX = center + radius * Math.cos(nextAngle);
                    const endY = center + radius * Math.sin(nextAngle);
                    const largeArc = nextAngle - angle > Math.PI ? 1 : 0;
                    const displayUnit = entry.count === 1 ? (unit === 'registered accounts' ? 'registered account' : unit.replace(/s$/, '')) : unit;
                    const tooltip = `${entry.label}: ${entry.count} ${displayUnit}`;

                    if (entry.count === total) {
                        const fullSlice = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
                        fullSlice.setAttribute('cx', center);
                        fullSlice.setAttribute('cy', center);
                        fullSlice.setAttribute('r', radius);
                        fullSlice.setAttribute('fill', entry.color);
                        fullSlice.setAttribute('class', 'role-pie-slice');
                        fullSlice.setAttribute('tabindex', '0');
                        fullSlice.setAttribute('aria-label', tooltip);
                        const title = document.createElementNS('http://www.w3.org/2000/svg', 'title');
                        title.textContent = tooltip;
                        fullSlice.append(title);
                        slices.append(fullSlice);
                        return;
                    }

                    path.setAttribute('d', `M ${center} ${center} L ${startX} ${startY} A ${radius} ${radius} 0 ${largeArc} 1 ${endX} ${endY} Z`);
                    path.setAttribute('fill', entry.color);
                    path.setAttribute('class', 'role-pie-slice');
                    path.setAttribute('tabindex', '0');
                    path.setAttribute('aria-label', tooltip);
                    const title = document.createElementNS('http://www.w3.org/2000/svg', 'title');
                    title.textContent = tooltip;
                    path.append(title);
                    slices.append(path);
                    angle = nextAngle;
                });
            });

            document.querySelectorAll('.admin-user-delete-button').forEach((button) => {
                button.addEventListener('click', async () => {
                    const role = button.dataset.userRole;
                    const email = button.dataset.userEmail;
                    if (!window.confirm(`Permanently delete this ${role} account${email ? ` (${email})` : ''}? This cannot be undone.`)) return;

                    button.disabled = true;
                    try {
                        const response = await fetch('/delete-managed-user', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ userId: button.dataset.userId, role })
                        });
                        const result = await response.json();
                        if (!result.success) {
                            window.alert(result.message || 'Unable to delete this account.');
                            button.disabled = false;
                            return;
                        }
                        window.location.reload();
                    } catch (error) {
                        window.alert('Unable to delete this account. Check your connection and try again.');
                        button.disabled = false;
                    }
                });
            });

            const eventReportDialog = document.getElementById('event-report-download-dialog');
            if (eventReportDialog) {
                const events = JSON.parse(document.getElementById('participation-report-event-options').dataset.events);
                const fest = document.getElementById('event-report-fest');
                const event = document.getElementById('event-report-event');
                const button = document.getElementById('event-report-download-button');
                const status = document.getElementById('event-report-download-status');
                const opener = document.querySelector('[data-open-event-report]');
                let downloading = false;
                [...new Set(events.map(item => item.festName))].sort((a, b) => a.localeCompare(b))
                    .forEach(name => fest.add(new Option(name, name)));
                if (!events.length) status.textContent = 'No coordinator events are available yet.';
                opener.addEventListener('click', () => eventReportDialog.showModal());
                eventReportDialog.querySelectorAll('[data-close-event-report]').forEach(close => close.addEventListener('click', () => eventReportDialog.close()));
                eventReportDialog.addEventListener('close', () => opener.focus());
                fest.addEventListener('change', () => {
                    event.replaceChildren(new Option(fest.value ? 'Select event' : 'Select fest first', ''));
                    events.filter(item => item.festName === fest.value).forEach(item => event.add(new Option(item.name, item.id)));
                    event.disabled = !fest.value;
                    button.disabled = true;
                    status.textContent = 'Select a fest and event to download the ZIP.';
                });
                event.addEventListener('change', () => {
                    button.disabled = !event.value;
                    status.textContent = event.value ? "The ZIP includes report.txt and this event's uploaded photos. A written report is required." : 'Select an event to download the ZIP.';
                });
                document.getElementById('event-report-download-form').addEventListener('submit', async submit => {
                    submit.preventDefault();
                    if (!event.value || downloading) return;
                    downloading = true;
                    button.disabled = fest.disabled = event.disabled = true;
                    status.textContent = 'Preparing your report and photos...';
                    try {
                        const response = await fetch(`/event-content/report.zip?eventId=${encodeURIComponent(event.value)}`, { cache: 'no-store' });
                        if (!response.ok) {
                            const result = await response.json();
                            throw new Error(result.message || 'Unable to download this event report.');
                        }
                        const blob = await response.blob();
                        const url = URL.createObjectURL(blob);
                        const link = document.createElement('a');
                        link.href = url;
                        link.download = response.headers.get('content-disposition')?.match(/filename="([^"]+)"/)?.[1] || 'event-report.zip';
                        document.body.append(link);
                        link.click();
                        link.remove();
                        setTimeout(() => URL.revokeObjectURL(url), 60000);
                        status.textContent = 'Download started. If no photos were uploaded, the ZIP includes the report and a note.';
                    } catch (error) {
                        status.textContent = error.message || 'Unable to download. Please try again.';
                    } finally {
                        downloading = false;
                        fest.disabled = false;
                        event.disabled = !fest.value;
                        button.disabled = !event.value;
                    }
                });
            }

            const participationModal = document.getElementById('participation-report-modal');
            if (participationModal) {
                const eventOptions = document.getElementById('participation-report-event-options');
                const events = JSON.parse(eventOptions?.dataset.events || '[]');
                const reportFest = document.getElementById('report-fest-select');
                const reportEvent = document.getElementById('report-event-select');
                const reportStatus = document.getElementById('participation-report-status');
                const reportContent = document.getElementById('participation-report-content');
                const winnerGrid = document.getElementById('participation-winner-grid');
                const participantTable = document.getElementById('participation-report-table');
                const participantCount = document.getElementById('participation-count');
                let reportRequest;

                function closeParticipationReport() {
                    participationModal.hidden = true;
                    document.body.classList.remove('participation-report-open');
                }

                function populateReportEvents() {
                    reportEvent.replaceChildren(new Option(reportFest.value ? 'Select event' : 'Select fest first', ''));
                    events.filter((event) => event.festName === reportFest.value)
                        .forEach((event) => reportEvent.add(new Option(event.name, event.id)));
                    reportEvent.disabled = !reportFest.value;
                }

                function renderParticipants(participants, eventName, winners) {
                    participantCount.textContent = `${participants.length} participant${participants.length === 1 ? '' : 's'} · ${eventName}`;
                    winnerGrid.replaceChildren();
                    winners.forEach((participant) => {
                        const winner = document.createElement('article');
                        winner.className = `participation-winner winner-${participant.rank}`;
                        winner.innerHTML = `<span class="participation-winner-rank">#${participant.rank}</span><strong></strong><small></small>`;
                        winner.querySelector('strong').textContent = participant.studentName;
                        winner.querySelector('small').textContent = participant.enrollmentNumber || 'Enrollment not recorded';
                        winnerGrid.append(winner);
                    });
                    if (!winners.length) {
                        const emptyWinner = document.createElement('p');
                        emptyWinner.className = 'participation-report-empty';
                        emptyWinner.textContent = 'The coordinator has not announced winners for this event yet.';
                        winnerGrid.append(emptyWinner);
                    }
                    participantTable.replaceChildren();
                    participants.forEach((participant, index) => {
                        const row = document.createElement('tr');
                        [index + 1, participant.name, participant.enrollment, participant.email, participant.department, participant.semester, participant.college].forEach((value) => {
                            const cell = document.createElement('td');
                            cell.textContent = value || 'Not recorded';
                            row.append(cell);
                        });
                        participantTable.append(row);
                    });
                    reportContent.hidden = false;
                }

                async function loadReport() {
                    reportContent.hidden = true;
                    if (!reportEvent.value) {
                        reportStatus.textContent = 'Select a fest and event to view the report.';
                        return;
                    }
                    reportRequest?.abort();
                    reportRequest = new AbortController();
                    reportStatus.textContent = 'Loading participation records...';
                    try {
                        const response = await fetch(`/admin-dashboard/participation?eventId=${encodeURIComponent(reportEvent.value)}`, { signal: reportRequest.signal, cache: 'no-store' });
                        if (!response.ok) throw new Error('Unable to load participation records.');
                        const documentFragment = new DOMParser().parseFromString(await response.text(), 'text/html');
                        const rows = [...documentFragment.querySelectorAll('.participation-results tbody tr')].filter((row) => row.cells.length > 1);
                        const participants = rows.map((row) => ({
                            name: row.cells[0].textContent.trim(),
                            enrollment: row.cells[1].textContent.trim(),
                            email: row.cells[2].textContent.trim(),
                            department: row.cells[5].textContent.trim(),
                            semester: row.cells[6].textContent.trim(),
                            college: row.cells[7].textContent.trim()
                        }));
                        const selectedEvent = events.find((event) => event.id === reportEvent.value);
                        const winnersResponse = await fetch(`/event-content/winners?eventId=${encodeURIComponent(reportEvent.value)}`, { signal: reportRequest.signal, cache: 'no-store' });
                        if (!winnersResponse.ok) throw new Error('Unable to load event winners.');
                        const { winners } = await winnersResponse.json();
                        renderParticipants(participants, selectedEvent?.name || 'Selected event', winners);
                        reportStatus.textContent = '';
                    } catch (error) {
                        if (error.name === 'AbortError') return;
                        reportStatus.textContent = 'Unable to load this report. Please try again.';
                    }
                }

                [...new Set(events.map((event) => event.festName))].sort((a, b) => a.localeCompare(b))
                    .forEach((festName) => reportFest.add(new Option(festName, festName)));
                document.querySelector('[data-open-participation-report]')?.addEventListener('click', () => {
                    participationModal.hidden = false;
                    document.body.classList.add('participation-report-open');
                    reportFest.focus();
                });
                participationModal.querySelectorAll('[data-close-participation-report]').forEach((element) => element.addEventListener('click', closeParticipationReport));
                reportFest.addEventListener('change', () => { populateReportEvents(); loadReport(); });
                reportEvent.addEventListener('change', loadReport);
                participationModal.addEventListener('keydown', (event) => {
                    if (event.key === 'Escape') closeParticipationReport();
                });
            }
        })();
    </script>
    <script src="/admin-users.js"></script>
    <script src="/admin-approvals.js"></script>
</body>
</html>
